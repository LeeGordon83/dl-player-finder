{% extends '_layout.njk' %}

{% block content %}
<div class="container">
  <h1>Users</h1>
  {% if error %}
    <div class="alert alert-danger">{{ error }}</div>
  {% endif %}
  <table class="table table-striped">
    <thead>
      <tr>
        <th style="text-align:center">Email</th>
        <th style="text-align:center">Edit Email</th>
        <th style="text-align:center">Reset Password</th>
      </tr>
    </thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td style="text-align:center">{{ user.email }}</td>
          <td style="text-align:center">
            <a href="/edit-email/{{ user._id }}" class="btn btn-primary">Edit Email</a>
          </td>
          <td style="text-align:center">
            <a href="/reset-password/{{ user._id }}" class="btn btn-secondary">Reset Password</a>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
