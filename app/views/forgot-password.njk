{% extends '_layout.njk' %}

{% block content %}
<div class="row justify-content-center">
  <div class="col-md-4">
    
    <form id='forgot-password-form' action='/forgot-password' method='POST'>
      <input type='hidden' name='crumb' value='{{ crumb }}'>
      
      <div class="form-group text-center mb-3">
        <label for="email">Enter your email address</label>
        <input class='form-control mx-auto' type='email' id="email" name='email' placeholder='Email' required>
        <small class="form-text text-muted">We'll send you a password reset link.</small>
      </div>
      
      <div class="form-group text-center mb-3">
        <input class='btn btn-primary mx-auto' form='forgot-password-form' type='submit' value='Reset Password'>
      </div>
    </form>
    
    <div class="text-center mt-3">
      <a href='/login'>Back to Login</a>
    </div>
    
    {% if error %}
      <div class="alert alert-danger text-center mt-3">{{ error }}</div>
    {% endif %}
    
    {% if success %}
      <div class="alert alert-success text-center mt-3">{{ success }}</div>
    {% endif %}
  </div>
</div>
{% endblock %}
