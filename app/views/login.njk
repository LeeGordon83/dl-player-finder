{% extends '_layout.njk' %}

{% block content %}
<div class="row justify-content-center">
  <div class="col-md-4">
    <form id='authenticate' action='/login' autocomplete='off' method='POST'>
    <input type='hidden' name='crumb' value='{{ crumb }}'>
      <div class="form-group text-center">
        <input class='form-control mx-auto' type='email' name='email' placeholder='Email' required>
      </div>
      <div class="form-group text-center">
        <input class='form-control mx-auto' type='password' name='password' placeholder='Password' required>
      </div>
      <div class="form-group text-center">
        <input class='btn btn-primary mx-auto' form='authenticate' type='submit' value='Login'>
      </div>
    </form>
    <div class="text-center">
      <a id='forgot-password' href='/forgot-password'>Forgot your password?</a> |
      <a id='register' href='/register'>Register</a>
    </div>
    {% if error %}
      <div id='flash' class="alert alert-danger text-center">{{ error }}</div>
    {% endif %}
  </div>
</div>
{% endblock %}
